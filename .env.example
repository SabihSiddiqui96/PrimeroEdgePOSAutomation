# Copy to .env and fill in. Never commit .env.

# Environment under test
BASE_URL=https://qa.primeroedge.co
LOGIN_PATH=/login.aspx
DASHBOARD_PATH=/dashboard.aspx
POS_HOME_PATH=/POS/POSHome.aspx
DISTRICT_NAME=MERCER COUNTY SCHOOLS

# Credentials. ENCRYPTION_KEY must be exactly 32 characters.
# Generate ENCRYPTED_PASSWORD with: npm run encrypt "<plain password>"
PE_USERNAME=
ENCRYPTION_KEY=
ENCRYPTED_PASSWORD=

# Optional timeout overrides (milliseconds)
# TEST_TIMEOUT_MS=90000
# ACTION_TIMEOUT_MS=15000
# POS_LOAD_TIMEOUT_MS=45000
